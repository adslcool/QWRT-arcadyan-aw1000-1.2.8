#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1
start_service() {
    [ "$(uci -q get mwan3.globals.aw1000_enabled)" = 1 ] || return 0
    /usr/sbin/aw1000-network-cleanup
    # stop_service() stops mwan3 as well. Recreate it through the same queued
    # entry point after a manager restart, without starting a second init pass.
    mkdir -p /var/run/aw1000-internet
    rm -f /var/run/aw1000-internet/stopping
    if ! /etc/init.d/mwan3 running; then
        touch /var/run/aw1000-internet/mwan-reload-needed
    fi
    for mode in run monitor ipv6-worker; do
        procd_open_instance "$mode"
        procd_set_param command /usr/sbin/aw1000-internet "--$mode"
        procd_set_param respawn 3600 5 0
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done
}
stop_service() {
    mkdir -p /var/run/aw1000-internet
    touch /var/run/aw1000-internet/stopping
    # Drain the whole old reconciliation round, not just one apply step.
    # Release the barrier before services/hotplug; callbacks only queue work.
    exec 7>/var/run/aw1000-internet/reconcile.lock
    flock -x 7
    flock -u 7
    exec 7>&-
    /etc/init.d/mwan3 stop
    /usr/sbin/aw1000-mwan-follow --restore
    /etc/init.d/firewall reload
}
service_triggers() {
    procd_add_reload_trigger 'aw1000'
}
