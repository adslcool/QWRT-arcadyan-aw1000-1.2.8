#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
    procd_open_instance panel
    procd_set_param command /usr/bin/lua /usr/sbin/aw1000-leds.lua
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    procd_open_instance wifi-events
    procd_set_param command /usr/sbin/aw1000-wifi-toggle --watch
    procd_set_param respawn 3600 5 0
    procd_close_instance
}
