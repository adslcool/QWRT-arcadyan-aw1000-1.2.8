#!/bin/sh
# SN-v3, compatible with aw1000-lede v1.50. No IMEI dependency.
set -eu
valid_sn() {
    [ "${#1}" = 13 ] || return 1
    case "$1" in ARC??????????) case "${1#ARC}" in *[!0-9]*) return 1;; esac;; *) return 1;; esac
}
read_sn() {
    result=''
    # A value is accepted only from explicitly identified board data or SN properties.
    for f in /sys/firmware/devicetree/base/serial-number /sys/devices/soc0/serial_number; do
        [ -r "$f" ] || continue
        value=$(tr -d '\000\r\n' < "$f")
        valid_sn "$value" && result="$result $value" || :
    done
    for part in $(awk -F'"' 'tolower($2)=="board_data" || tolower($2)=="0:board_data" {split($1,a,":"); print a[1]}' /proc/mtd); do
        index=${part#mtd}
        [ "$index" != "$part" ] || continue
        case "$index" in ''|*[!0-9]*) continue;; esac
        [ -c "/dev/$part" ] || continue
        size=$(cat "/sys/class/mtd/$part/size" 2>/dev/null) || continue
        case "$size" in ''|*[!0-9]*) continue;; esac
        [ "$size" -gt 0 ] && [ "$size" -le 16777216 ] || continue
        temporary=$(mktemp /tmp/aw1000-sn.XXXXXX) || continue
        chmod 600 "$temporary"
        if ! dd if="/dev/$part" of="$temporary" bs=4096 count=$(((size+4095)/4096)) 2>/dev/null ||
                [ "$(wc -c < "$temporary" | tr -d ' ')" != "$size" ]; then
            rm -f "$temporary"
            continue
        fi
        values=$(LC_ALL=C tr -cs 'A-Za-z0-9' '\n' < "$temporary" | LC_ALL=C sed -n '/^ARC[0-9]\{10\}$/p')
        rm -f "$temporary"
        result="$result $values"
    done
    # A correctly configured fw_printenv may expose the same factory SN.
    if command -v fw_printenv >/dev/null 2>&1 && [ -s /etc/fw_env.config ]; then
        for name in serial# serialno; do
            value=$(fw_printenv -n "$name" 2>/dev/null) || continue
            valid_sn "$value" && result="$result $value" || :
        done
    fi
    values=$(printf '%s\n' $result | sed '/^$/d' | sort -u)
    set -- $values
    # An explicit case-label hint is used only when hardware supplied no valid SN.
    if [ "$#" = 0 ] && [ -r /etc/aw1000-mod/serial.hint ]; then
        value=$(tr -d '\000\r\n' < /etc/aw1000-mod/serial.hint)
        if valid_sn "$value"; then printf '%s\n' "$value"; return 0; fi
    fi
    [ "$#" = 1 ] && valid_sn "$1" || return 1
    printf '%s\n' "$1"
}
derive() {
    serial=$1
    valid_sn "$serial" || return 2
    key=${AW1000_KEY:-}
    if [ -z "$key" ]; then
        key=$(cat /etc/aw1000-mod/derivation.key)
    fi
    [ "${#key}" = 64 ] || return 2
    case "$key" in *[!a-fA-F0-9]*) return 2;; esac
    counter=0
    while [ "$counter" -lt 100 ]; do
        digest=$(printf '%s' "aw1000:root-password:sn-v3:$serial:$counter" |
            openssl dgst -sha256 -mac HMAC -macopt "hexkey:$key") || return 1
        digest=${digest##* }
        password=$(printf '%s\n' "$digest" | awk '
          function hex(c) { return index("0123456789abcdef",tolower(c))-1 }
          { a="abcdefghijklmnopqrstuvwxyz0123456789"; out=""; letter=0; number=0;
            if (length($0)!=64) exit 1;
            for(i=1;i<=64 && length(out)<8;i+=2) {
              h=hex(substr($0,i,1)); l=hex(substr($0,i+1,1)); if(h<0 || l<0) exit 1;
              b=16*h+l; if(b>=252) continue; c=substr(a,b%36+1,1); out=out c;
              if(c ~ /[0-9]/) number=1; else letter=1;
            }
            if(length(out)==8 && letter && number) print out;
          }') || return 1
        if [ -n "$password" ]; then printf '%s\n' "$password"; return 0; fi
        counter=$((counter+1))
    done
    return 1
}
case "${1:-show}" in
    serial) read_sn;;
    derive) [ "$#" = 2 ] || exit 2; derive "$2";;
    show)
        if [ -r /etc/aw1000-mod/credentials.info ]; then
            mode=$(sed -n 's/^mode=//p' /etc/aw1000-mod/credentials.info)
            case "$mode" in
                sn-v3) serial=$(sed -n 's/^serial=//p' /etc/aw1000-mod/credentials.info); derive "$serial";;
                fallback) printf '%s\n' password;;
                explicit) echo '首次初始化使用手填密码或 Secret；无法还原明文' >&2; exit 1;;
                *) exit 1;;
            esac
        elif serial=$(read_sn); then derive "$serial"; else printf '%s\n' password; fi
        ;;
    status)
        if [ -r /etc/aw1000-mod/credentials.info ]; then cat /etc/aw1000-mod/credentials.info;
        else echo 'mode=legacy-or-uninitialized'; fi
        awk -F: '$1=="root" {
            if ($2 ~ /^\$1\$/) print "shadow_format=md5-crypt";
            else if ($2 ~ /^\$6\$/) print "shadow_format=sha512-crypt-unsupported";
            else if ($2 ~ /^[!*]/) print "shadow_format=locked";
            else print "shadow_format=other";
        }' /etc/shadow
        ;;
    *) echo 'Usage: aw1000-credentials [serial|show|status|derive ARCxxxxxxxxxx]' >&2; exit 2;;
esac
