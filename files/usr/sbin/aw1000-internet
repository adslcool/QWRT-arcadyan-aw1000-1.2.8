#!/bin/sh
# AW1000 configuration and SIM eligibility. IPv4 rules remain owned by mwan3.
set -eu
umask 077
RUN=${AW1000_INTERNET_RUN:-/var/run/aw1000-internet}
PENDING=${AW1000_PENDING:-/etc/aw1000-internet-pending}
CONFIG=${AW1000_CONFIG_ROOT:-/etc/config}
mkdir -p "$RUN"
get() { uci -q get "$1" || true; }
valid() { case "$1" in ''|*[!A-Za-z0-9_]*) return 1;; esac; }
now() { cut -d. -f1 /proc/uptime; }
generation() {
    port=$(get "qmodem.$1.override_at_port")
    [ -n "$port" ] || port=$(get "qmodem.$1.at_port")
    case "$port" in /dev/ttyUSB[0-9]*) :;; *) echo missing; return;; esac
    path=$(readlink -f "${AW1000_SYS_ROOT:-/sys}/class/tty/${port##*/}/device" 2>/dev/null) || path=''
    while [ -n "$path" ] && [ "$path" != / ]; do
        if [ -r "$path/devnum" ] && [ -r "$path/busnum" ]; then
            printf '%s:%s:%s\n' "$path" "$(cat "$path/busnum")" "$(cat "$path/devnum")"
            return
        fi
        path=${path%/*}
    done
    echo missing
}
classify() {
    response=$(printf '%s' "$1" | tr -d '\r')
    if printf '%s\n' "$response" | grep -qE '^\+CPIN: READY[[:space:]]*$'; then echo ready
    elif printf '%s\n' "$response" | grep -qE '^\+CPIN: (SIM PIN|SIM PUK|PH-)|^\+CME ERROR: (11|12)[[:space:]]*$'; then echo locked
    elif printf '%s\n' "$response" | grep -qiE '^\+CPIN: NOT INSERTED|^\+CME ERROR: (10|SIM not inserted)[[:space:]]*$'; then echo absent
    elif printf '%s\n' "$response" | grep -qiE '^\+CME ERROR: (13|SIM failure)[[:space:]]*$'; then echo failed
    else echo unknown; fi
}
publish() {
    previous=$(jq -r '[.modem,.state]|join(":")' "$RUN/sim.json" 2>/dev/null || true)
    state=$(classify "$(printf '%s' "$1" | tr -d '\r' | sed '/^[[:space:]]*$/d')")
    jq -cn --arg modem "$2" --arg state "$state" --argjson time "$(now)" --arg generation "$(generation "$2")" \
        '{modem:$modem,state:$state,time:$time,generation:$generation}' > "$RUN/sim.tmp.$$"
    mv "$RUN/sim.tmp.$$" "$RUN/sim.json"
    case "$state" in ready) ready=1;; *) ready=0;; esac
    dir="/var/run/qmodem/${2}_dir"
    [ ! -d "$dir" ] || printf '%s\n' "$ready" > "$dir/aw1000-sim-ready"
    [ "$previous" = "$2:$state" ] || touch "$RUN/dirty"
}
sim_state() {
    modem=${1:-$(get mwan3.globals.aw1000_modem)}
    valid "$modem" || { echo unknown; return 0; }
    jq -r --arg modem "$modem" --argjson now "$(now)" --arg generation "$(generation "$modem")" \
        'if .modem==$modem and $generation!="missing" and .generation==$generation and ($now-.time)>=0 and ($now-.time)<=20 then .state else "unknown" end' \
        "$RUN/sim.json" 2>/dev/null || echo unknown
}
publish_radio() {
    # QENG field positions match the pinned Quectel vendor parser. Query through
    # at-daemon; this adds one command, rather than a full Web status collection.
    sample=$(printf '%s\n' "$1" | tr -d '\r"' | awk -F, '
      function power(v) { return v ~ /^-[0-9]+$/ && v+0>=-140 && v+0<=-25 }
      /^[ \t]*\+QENG:/ {
        for (i=1;i<=NF;i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
        if ($2=="SEARCH" || $2=="LIMSRV") { unavailable=1; next }
        if ($1=="+QENG: NR5G-NSA") { nsa=1; if (power($5)) nr=$5+0 }
        if ($1=="+QENG: LTE") { lte=1; if (power($12)) lp=$12+0 }
        if ($1=="+QENG: servingcell" && ($2=="NOCONN" || $2=="CONNECT")) {
          if ($3=="NR5G-SA") { sa=1; if (power($13)) sp=$13+0 }
          if ($3=="LTE" || $3=="CAT-M" || $3=="CAT-NB") { lte=1; if (power($14)) lp=$14+0 }
          if ($3=="WCDMA") { wcdma=1; if (power($11)) wp=$11+0 }
        }
      }
      END {
        rat="unknown"; db="null"; metric="rsrp"; registered="null"
        if (unavailable) registered="false"
        if (!unavailable) {
          if (sa) { rat="sa"; if (sp!="") db=sp }
          else if (nsa) { rat="nsa"; if (nr!="") db=nr }
          else if (lte) { rat="lte"; if (lp!="") db=lp }
          else if (wcdma) { rat="wcdma"; metric="rscp"; if (wp!="") db=wp }
        }
        if (rat!="unknown") registered="true"
        printf "{\"rat\":\"%s\",\"dbm\":%s,\"metric\":\"%s\",\"registered\":%s}\n",rat,db,metric,registered
      }')
    jq -cn --argjson sample "$sample" --arg modem "$2" --arg generation "$(generation "$2")" --argjson time "$(now)" \
        '$sample + {modem:$modem,generation:$generation,time:$time}' > "$RUN/radio.tmp.$$"
    mv "$RUN/radio.tmp.$$" "$RUN/radio.json"
}
radio_state() {
    modem=${1:-$(get mwan3.globals.aw1000_modem)}
    valid "$modem" || { echo '{}'; return 0; }
    jq -c --arg modem "$modem" --argjson now "$(now)" --arg generation "$(generation "$modem")" \
        'if .modem==$modem and $generation!="missing" and .generation==$generation and
            ($now-.time)>=0 and ($now-.time)<=20 then . else {} end' \
        "$RUN/radio.json" 2>/dev/null || echo '{}'
}
monitor() {
    while :; do
        modem=$(get mwan3.globals.aw1000_modem)
        if valid "$modem" && [ "$(get mwan3.globals.aw1000_enabled)" = 1 ]; then
            port=$(get "qmodem.$modem.override_at_port")
            [ -n "$port" ] || port=$(get "qmodem.$modem.at_port")
            case "$port" in /dev/ttyUSB[0-9]*)
                # Same command queue as the telephone backend; no direct serial I/O.
                before=$(generation "$modem")
                response=$(/usr/sbin/aw1000-phone-at "$port" 'AT+CPIN?' 2>/dev/null) || response=''
                [ "$before" = "$(generation "$modem")" ] || response=''
                publish "$response" "$modem"
                before=$(generation "$modem")
                response=$(/usr/sbin/aw1000-phone-at "$port" 'AT+QENG="servingcell"' 2>/dev/null) || response=''
                [ "$before" = "$(generation "$modem")" ] || response=''
                publish_radio "$response" "$modem"
                ;;
            esac
        fi
        sleep 5
    done
}
gate() {
    old=$(cat "$RUN/blocked" 2>/dev/null || true)
    applied=$(cat "$RUN/gate-applied" 2>/dev/null || true)
    if [ "$(get mwan3.globals.aw1000_enabled)" != 1 ]; then
        rm -f "$RUN/blocked" "$RUN/gate-applied"
        if valid "$old"; then /usr/sbin/mwan3 ifup "$old"; fi
        return 0
    fi
    cell=$(get mwan3.globals.aw1000_cellular)
    valid "$cell" || return 0
    state=$(sim_state)
    case "$state" in
        absent|locked|failed)
            printf '%s\n' "$cell" > "$RUN/blocked.tmp"; mv "$RUN/blocked.tmp" "$RUN/blocked"
            if [ "$applied" != "block:$cell" ]; then
                DEVICE=$(ubus call "network.interface.$cell" status 2>/dev/null | jq -r ".l3_device // empty") ACTION=disconnected INTERFACE="$cell" /sbin/hotplug-call iface
                echo "block:$cell" > "$RUN/gate-applied"
                logger -t aw1000-internet "Cellular excluded: SIM $state"
            fi;;
        ready)
            if [ -n "$old" ] || [ "$applied" = "block:$cell" ] || [ "$applied" = "recover:$cell" ]; then
                if [ "$applied" != "recover:$cell" ]; then
                    # Keep the hard gate closed while native tracking restarts.
                    printf '%s\n' "$cell" > "$RUN/blocked"
                    /usr/sbin/mwan3 ifup "$cell"
                    echo "recover:$cell" > "$RUN/gate-applied"
                    now > "$RUN/recovery-start"
                    rm -f "$RUN/recovery-seen"
                    logger -t aw1000-internet 'SIM ready; waiting for native IPv4 recovery checks'
                else
                    track="${AW1000_MWAN_TRACK:-/var/run/mwan3track}/$cell"
                    status=$(cat "$track/STATUS" 2>/dev/null || echo unknown)
                    case "$status" in offline|connecting|disabled) touch "$RUN/recovery-seen";; esac
                    last=$(cat "$track/TIME" 2>/dev/null || echo 0)
                    case "$last" in ''|*[!0-9]*) last=0;; esac
                    start=$(cat "$RUN/recovery-start" 2>/dev/null || now)
                    if [ "$status" = online ] && [ -f "$RUN/recovery-seen" ] && [ "$last" -ge "$start" ] && [ "$last" -le "$(now)" ] && [ "$(( $(now)-last ))" -le 10 ]; then
                        rm -f "$RUN/blocked"
                        # Persist release intent before retryable publication.
                        echo "release:$cell" > "$RUN/gate-applied"
                        /usr/sbin/mwan3 ifup "$cell"
                        rm -f "$RUN/gate-applied" "$RUN/recovery-seen" "$RUN/recovery-start"
                    fi
                fi
            elif [ "$applied" = "release:$cell" ]; then
                /usr/sbin/mwan3 ifup "$cell"
                rm -f "$RUN/gate-applied" "$RUN/recovery-seen" "$RUN/recovery-start"
            fi;;
        *)
            # Retry an interrupted exclusion even when a later AT query is busy.
            if [ "$old" = "$cell" ] && [ "$applied" != "block:$cell" ] && [ "$applied" != "recover:$cell" ]; then
                DEVICE=$(ubus call "network.interface.$cell" status 2>/dev/null | jq -r ".l3_device // empty") ACTION=disconnected INTERFACE="$cell" /sbin/hotplug-call iface
                echo "block:$cell" > "$RUN/gate-applied"
            fi;;
    esac
}
reload_network() {
    touch "$RUN/reload-needed" "$RUN/dirty"
}
rollback() {
    [ -d "$PENDING" ] || return 0
    for name in network mwan3 aw1000 qmodem dhcp firewall; do
        uci -q revert "$name" || true
        cp "$PENDING/$name" "$CONFIG/$name" || return 1
    done
    rm -rf "$PENDING"
    reload_network
    logger -t aw1000-internet 'Unconfirmed settings rolled back'
}
sync_routes() {
    [ "$(get mwan3.globals.aw1000_enabled)" = 1 ] || return 0
    route_stamp=$(sha256sum "$CONFIG/network" 2>/dev/null || true)
    [ "$(cat "$RUN/routes-config-stamp" 2>/dev/null || true)" != "$route_stamp" ] || return 0
    [ -z "$(uci -q changes network)" ] || return 0
    priority=$(get aw1000.internet.priority)
    case "$priority" in wired|cellular|wired_only|cellular_only) :;; *) return 0;; esac
    changed=0
    cell=$(get mwan3.globals.aw1000_cellular)
    for iface in wan "$cell"; do
        valid "$iface" || continue
        [ "$(get "network.$iface")" = interface ] || continue
        # Keep both per-interface routes for native tracking and bound diagnostics.
        # Only aw_failover membership limits the normal Internet exit.
        if [ "$(get "network.$iface.defaultroute")" != 1 ]; then
            uci set "network.$iface.defaultroute=1"
            changed=1
        fi
    done
    if [ "$changed" = 1 ]; then
        uci commit network
        if [ "${1:-}" != --defer ]; then reload_network; fi
    fi
    sha256sum "$CONFIG/network" > "$RUN/routes-config-stamp.tmp"
    mv "$RUN/routes-config-stamp.tmp" "$RUN/routes-config-stamp"
}
route_default_present() {
    local route_table=$1 route_device=$2 route_gateway_value=$3
    ip -4 route show table "$route_table" default 2>/dev/null | awk -v dev="$route_device" -v gateway="$route_gateway_value" '
      $1=="default" {
        found_dev=""; found_gateway=""
        for (i=1;i<=NF;i++) {
          if ($i=="dev" && i<NF) found_dev=$(i+1)
          if ($i=="via" && i<NF) found_gateway=$(i+1)
        }
        if (found_dev==dev && (gateway=="" || found_gateway==gateway)) found=1
      }
      END { exit(found ? 0 : 1) }'
}
wan_mwan_table() {
    ip -4 rule show 2>/dev/null | awk -v dev="$1" '
      {
        matched=0
        for (i=1;i<NF;i++) if ($i=="iif" && $(i+1)==dev) matched=1
        if (matched) for (i=1;i<NF;i++) if ($i=="lookup") { print $(i+1); exit }
      }'
}
route_guard() {
    local info plan route_dev route_src route_gateway route_metric table main_ok table_ok current last
    [ ! -f "$RUN/stopping" ] || return 0
    [ "$(get mwan3.globals.aw1000_enabled)" = 1 ] || return 0
    info=$(ubus call network.interface.wan status 2>/dev/null) || return 0
    plan=$(printf '%s' "$info" | jq -ce '
      select(.up==true and ([.route[]? | select(.target=="0.0.0.0" and .mask==0)]|length)>0) |
      {dev:(.l3_device // .device // ""),
       src:([.["ipv4-address"][]?.address][0] // ""),
       gateway:([.route[]? | select(.target=="0.0.0.0" and .mask==0) |
                  (.nexthop // "")][0] // "")} |
      select(.dev!="" and .src!="")' 2>/dev/null) || return 0
    route_dev=$(printf '%s' "$plan" | jq -r .dev)
    route_src=$(printf '%s' "$plan" | jq -r .src)
    route_gateway=$(printf '%s' "$plan" | jq -r .gateway)
    case "$route_dev" in ''|*[!A-Za-z0-9_.:-]*) return 0;; esac
    case "$route_src" in ''|*[!0-9.]*) return 0;; esac
    case "$route_gateway" in *[!0-9.]*) return 0;; esac
    if [ -z "$route_gateway" ]; then
        [ "$(get network.wan.proto)" = pppoe ] || return 0
        case "$route_dev" in ppp*) :;; *) return 0;; esac
    fi
    route_metric=$(get network.wan.metric)
    case "$route_metric" in ''|*[!0-9]*) route_metric=10;; esac

    table=$(wan_mwan_table "$route_dev")
    case "$table" in ''|*[!0-9]*) table='';; esac
    main_ok=0; table_ok=0
    route_default_present main "$route_dev" "$route_gateway" && main_ok=1
    [ -z "$table" ] || { route_default_present "$table" "$route_dev" "$route_gateway" && table_ok=1; }
    [ "$main_ok" = 0 ] || [ "$table_ok" = 0 ] || return 0

    current=$(now); last=$(cat "$RUN/wan-route-guard.last" 2>/dev/null || echo 0)
    case "$current:$last" in *[!0-9:]*) return 0;; esac
    [ "$((current-last))" -ge 20 ] || return 0
    printf '%s\n' "$current" > "$RUN/wan-route-guard.last.tmp"
    mv "$RUN/wan-route-guard.last.tmp" "$RUN/wan-route-guard.last"

    if [ "$main_ok" = 0 ]; then
        if [ -n "$route_gateway" ]; then
            ip -4 route replace default via "$route_gateway" dev "$route_dev" src "$route_src" metric "$route_metric" || return 1
        else
            ip -4 route replace default dev "$route_dev" src "$route_src" metric "$route_metric" || return 1
        fi
    fi
    # Rebuild the interface-owned table through mwan3 instead of assuming that
    # wan is always table 1.  The cooldown lets its four recovery probes finish.
    if [ "$table_ok" = 0 ]; then
        /usr/sbin/mwan3 ifup wan || return 1
    fi
    jq -cn --argjson time "$current" --arg dev "$route_dev" --arg src "$route_src" \
        --arg gateway "$route_gateway" --arg table "$table" --arg main_missing "$((1-main_ok))" \
        --arg table_missing "$((1-table_ok))" \
        '{time:$time,device:$dev,source:$src,gateway:$gateway,table:$table,
          repaired:{main:($main_missing=="1"),mwan:($table_missing=="1")}}' \
        > "$RUN/wan-route-guard.json.tmp"
    mv "$RUN/wan-route-guard.json.tmp" "$RUN/wan-route-guard.json"
    logger -t aw1000-internet "Restored missing WAN default route (main=$((1-main_ok)) mwan=$((1-table_ok)))"
}
tick() (
    exec 8>"$RUN/apply.lock"; flock -n 8 || return "${1:-0}"
    if [ -f "$PENDING/deadline" ]; then
        if [ "$(cat "$PENDING/boot" 2>/dev/null || true)" != "$(cat /proc/sys/kernel/random/boot_id)" ] || [ "$(now)" -ge "$(cat "$PENDING/deadline")" ]; then rollback; fi
    fi
    sync_routes
    gate
)
status() {
    cell=$(get mwan3.globals.aw1000_cellular)
    wired=$(ubus -t 3 call network.interface.wan status 2>/dev/null) || wired='{}'
    cellular='{}'; if valid "$cell"; then cellular=$(ubus -t 3 call "network.interface.$cell" status 2>/dev/null) || cellular='{}'; fi
    tracking='{}'
    for pair in "wan:wan" "cellular:$cell"; do
        key=${pair%%:*}; iface=${pair#*:}
        valid "$iface" || continue
        dir="/var/run/mwan3track/$iface"
        role=$(cat "$dir/AW_ROLE" 2>/dev/null || echo unknown)
        period=$(cat "$dir/AW_INTERVAL" 2>/dev/null || echo 0)
        last_success=$(cat "$dir/AW_LAST_SUCCESS" 2>/dev/null || echo 0)
        attempts=$(cat "$dir/AW_PROBE_ATTEMPTS" 2>/dev/null || echo 0)
        last_probe=$(cat "$dir/AW_LAST_PROBE" 2>/dev/null || echo 0)
        tracking=$(printf '%s' "$tracking" | jq -c --arg key "$key" --arg role "$role" --arg period "$period" --arg last "$last_success" --arg attempts "$attempts" --arg probe "$last_probe" \
            '.+{($key):{role:$role,interval:($period|tonumber? // 0),attempts:($attempts|tonumber? // 0),last_probe_uptime:($probe|tonumber? // 0),last_success_uptime:($last|tonumber? // 0)}}')
    done
    cell_dev=$(printf '%s' "$cellular" | jq -r '.l3_device // empty')
    rx=0; tx=0
    case "$cell_dev" in ''|*[!A-Za-z0-9_.:-]*) :;; *)
        rx=$(cat "${AW1000_SYS_ROOT:-/sys}/class/net/$cell_dev/statistics/rx_bytes" 2>/dev/null || echo 0)
        tx=$(cat "${AW1000_SYS_ROOT:-/sys}/class/net/$cell_dev/statistics/tx_bytes" 2>/dev/null || echo 0);;
    esac
    jq -cn --arg priority "$(get aw1000.internet.priority)" --arg mode "$(get network.wan.proto)" \
        --argjson sync "$(cat /var/run/aw1000-mwan-follow/state.json 2>/dev/null || echo '{}')" \
        --argjson radio "$(jq -c '{status:.radio_sample_status,age:.radio_sample_age,device_missing:.modem_disappeared}' /var/run/aw1000-leds.json 2>/dev/null || echo '{}')" \
        --argjson tracking "$tracking" --arg rx "$rx" --arg tx "$tx" \
        --arg username "$(get network.wan.username)" --arg vlan "$(get aw1000.internet.vlan)" --arg mtu "$(get network.wan.mtu)" \
        --arg selected "$(cat /var/run/aw1000-mwan-follow/selected 2>/dev/null || true)" \
        --arg sim "$(sim_state)" --arg blocked "$(cat "$RUN/blocked" 2>/dev/null || true)" \
        --arg wan_health "$(cat /var/run/mwan3track/wan/STATUS 2>/dev/null || echo unknown)" \
        --arg wan_turn "$(cat /var/run/mwan3track/wan/TURN 2>/dev/null || echo 0)" \
        --arg cell_health "$(cat "/var/run/mwan3track/$cell/STATUS" 2>/dev/null || echo unknown)" \
        --argjson ipv6 "$(cat /var/run/aw1000-ipv6-follow/status.json 2>/dev/null || echo '{}')" \
        --arg dns_choice "$(cut -d '|' -f1 /var/run/aw1000-mwan-follow/dns-signature 2>/dev/null || true)" \
        --arg dns_mode "$(cut -d '|' -f2 /var/run/aw1000-mwan-follow/dns-signature 2>/dev/null || true)" \
        --arg dns_servers "$(cut -d '|' -f3- /var/run/aw1000-mwan-follow/dns-signature 2>/dev/null || true)" \
        --argjson wired "$wired" --argjson cellular "$cellular" \
        --argjson last "$(cat /var/run/aw1000-mwan-follow/event.json 2>/dev/null || echo '{}')" \
        --argjson remaining "$(if [ -f "$PENDING/deadline" ]; then r=$(( $(cat "$PENDING/deadline")-$(now) )); if [ "$r" -gt 0 ]; then echo "$r"; else echo 0; fi; else echo 0; fi | tail -n1)" \
        --argjson pending "$(if [ -d "$PENDING" ]; then echo true; else echo false; fi)" \
        '{sync:$sync,radio:$radio,priority:$priority,mode:$mode,username:$username,vlan:$vlan,mtu:$mtu,selected:$selected,sim:$sim,blocked:$blocked,wan_health:$wan_health,wan_turn:($wan_turn|tonumber? // 0),cell_health:$cell_health,tracking:$tracking,cellular_bytes:{rx:($rx|tonumber? // 0),tx:($tx|tonumber? // 0)},ipv6:$ipv6,dns_choice:$dns_choice,dns_mode:$dns_mode,dns_servers:$dns_servers,wired_errors:($wired.errors//[]),wired_up:($wired.up//false),cellular_up:($cellular.up//false),last:$last,pending:$pending,remaining:$remaining}'
}
apply() {
    input=$(cat)
    priority_only=0
    if [ "${1:-}" = --priority-only ]; then
        priority_only=1
        input=$(printf '%s' "$input" | jq -ce 'select(type=="object" and
          (.priority=="wired" or .priority=="cellular" or .priority=="wired_only" or .priority=="cellular_only")) |
          {priority,mode:"dhcp",username:"",password:"",vlan:"",mtu:""}') || {
            echo '{"error":"线路模式无效"}'; return 0;
        }
        if [ "$(printf '%s' "$input" | jq -r .priority)" = "$(get aw1000.internet.priority)" ] && [ ! -d "$PENDING" ]; then
            echo '{"ok":true,"unchanged":true}'; return 0
        fi
    fi
    # No eval, shell sourcing or generated UCI batch: credentials remain literal arguments.
    printf '%s' "$input" | jq -e '
        (.priority=="wired" or .priority=="cellular" or .priority=="wired_only" or .priority=="cellular_only") and (.mode=="dhcp" or .mode=="pppoe") and
        ([.username,.password,.vlan,.mtu]|all(type=="string" and length<=128 and (explode|all(.>=32 and .!=127)))) and
        (.mode!="pppoe" or (.username|length)>0) and
        (.vlan=="" or (.vlan|length>=1 and length<=4 and (explode|all(.>=48 and .<=57)) and (tonumber>=1 and tonumber<=4094))) and
        (.mtu=="" or (.mtu|length>=3 and length<=4 and (explode|all(.>=48 and .<=57)) and (tonumber>=1280 and tonumber<=1500))) and
        (.mode!="pppoe" or .mtu=="" or (.mtu|tonumber)<=1492)' >/dev/null || { echo '{"error":"输入无效，请检查 PPPoE 账号、VLAN 和 MTU"}'; return 0; }
    exec 8>"$RUN/apply.lock"; flock -x 8
    if [ -d "$PENDING" ] && [ ! -f "$PENDING/deadline" ]; then rm -rf "$PENDING"; fi
    [ ! -d "$PENDING" ] || { echo '{"error":"请先确认或等待上一次设置回退"}'; return 0; }
    # Refuse uncommitted/manual policy changes rather than silently replacing them.
    for config in network mwan3 aw1000 qmodem dhcp firewall; do
        [ -z "$(uci changes "$config")" ] || { echo '{"error":"请先应用或撤销其他页面未保存的配置"}'; return 0; }
    done
    case "$(get aw1000.internet.priority)" in
        wired_only) expected_members=aw_wired;;
        cellular_only) expected_members=aw_cell;;
        wired|cellular|'') expected_members='aw_wired aw_cell';;
        *) expected_members=unsupported;;
    esac
    if ! { [ "$(get mwan3.globals.aw1000_enabled)" = 1 ] &&
    [ "$(get mwan3.aw_default.family)" = ipv4 ] &&
    [ "$(get mwan3.aw_default.dest_ip)" = 0.0.0.0/0 ] &&
    [ "$(get mwan3.aw_failover.last_resort)" = unreachable ] &&
    [ "$(get mwan3.aw_default.use_policy)" = aw_failover ] && \
    [ "$(get mwan3.aw_failover.use_member)" = "$expected_members" ] && \
    [ "$(get mwan3.aw_wired.interface)" = wan ]; }; then
        echo '{"error":"检测到自定义策略，请先恢复 AW1000 默认策略"}'
        return 0
    fi
    extra=$(uci -q show mwan3 | sed -n 's/^mwan3\.\([A-Za-z0-9_]*\)=rule$/\1/p' | sed '/^aw_default$/d')
    [ -z "$extra" ] || { echo '{"error":"检测到额外 mwan3 规则，请先在高级页面确认策略兼容性"}'; return 0; }
    mode=$(printf '%s' "$input" | jq -r .mode)
    user=$(printf '%s' "$input" | jq -r .username)
    pass=$(printf '%s' "$input" | jq -r .password)
    if [ "$priority_only" = 0 ] && [ "$mode" = pppoe ] && [ -z "$pass" ] && [ -z "$(get network.wan.password)" ]; then echo '{"error":"首次配置 PPPoE 必须填写密码"}'; return 0; fi
    priority=$(printf '%s' "$input" | jq -r .priority)
    vlan=$(printf '%s' "$input" | jq -r '.vlan|if .=="" then . else tonumber|tostring end')
    mtu=$(printf '%s' "$input" | jq -r '.mtu|if .=="" then . else tonumber|tostring end')
    base=$(get aw1000.internet.base_device)
    [ -n "$base" ] || base=$(get network.wan.device)
    [ "$priority_only" = 0 ] || base=wan
    case "$base" in ''|*[!A-Za-z0-9_.:-]*) echo '{"error":"WAN 设备配置不受支持"}'; return 0;; esac
    mkdir "$PENDING"
    for name in network mwan3 aw1000 qmodem dhcp firewall; do cp "$CONFIG/$name" "$PENDING/$name"; done
    # Deadline is installed before mutation; the running service restores even if RPC is interrupted.
    cat /proc/sys/kernel/random/boot_id > "$PENDING/boot"
    echo "$(( $(now)+120 ))" > "$PENDING/deadline"
    uci set aw1000.internet=policy
    uci set "aw1000.internet.priority=$priority"
    if [ "$priority_only" = 0 ]; then
    uci set "aw1000.internet.base_device=$base"
    uci set "aw1000.internet.vlan=$vlan"
    uci set "network.wan.proto=$mode"
    if [ "$mode" = pppoe ]; then
        uci set "network.wan.username=$user"
        [ -z "$pass" ] || uci set "network.wan.password=$pass"
        uci set network.wan.ipv6=1
    fi
    if [ -n "$vlan" ]; then
        uci set network.aw_wan_vlan=device
        uci set network.aw_wan_vlan.type=8021q
        uci set "network.aw_wan_vlan.ifname=$base"
        uci set "network.aw_wan_vlan.vid=$vlan"
        uci set "network.aw_wan_vlan.name=$base.$vlan"
        uci set "network.wan.device=$base.$vlan"
    else
        uci set "network.wan.device=$base"
        uci -q delete network.aw_wan_vlan || true
    fi
    uci set network.wan_v6=interface
    uci set network.wan_v6.proto=dhcpv6
    uci set network.wan_v6.device=@wan
    uci -q delete network.wan_v6.ifname || true
    uci set network.wan_v6.reqprefix=auto
    if [ -n "$mtu" ]; then uci set "network.wan.mtu=$mtu"; else uci -q delete network.wan.mtu || true; fi
    fi
    if [ "$priority" = cellular ] || [ "$priority" = cellular_only ]; then wired_metric=2; cell_metric=1; else wired_metric=1; cell_metric=2; fi
    uci -q delete mwan3.aw_failover.use_member || true
    case "$priority" in
        wired_only) uci add_list mwan3.aw_failover.use_member=aw_wired;;
        cellular_only) uci add_list mwan3.aw_failover.use_member=aw_cell;;
        *) uci add_list mwan3.aw_failover.use_member=aw_wired
           uci add_list mwan3.aw_failover.use_member=aw_cell;;
    esac
    uci set "mwan3.aw_wired.metric=$wired_metric"
    uci set "mwan3.aw_cell.metric=$cell_metric"
    # Main-table metrics match selected preference for unmarked router traffic.
    uci set "network.wan.metric=$((wired_metric*10))"
    uci set "network.wan_v6.metric=$((wired_metric*10))"
    cell=$(get mwan3.globals.aw1000_cellular)
    if valid "$cell" && [ "$(get "network.$cell")" = interface ]; then
        uci set "network.$cell.metric=$((cell_metric*10))"
        if [ "$(get "network.${cell}_v6")" = interface ]; then uci set "network.${cell}_v6.metric=$((cell_metric*10))"; fi
    fi
    modem=$(get mwan3.globals.aw1000_modem)
    if valid "$modem"; then uci set "qmodem.$modem.metric=$((cell_metric*10))"; fi
    uci set "qmodem.usb0.default_metric=$((cell_metric*10))"
    for name in network mwan3 aw1000 qmodem dhcp firewall; do uci commit "$name"; done
    sync_routes --defer
    reload_network
    echo '{"ok":true,"timeout":120}'
}
reconcile_once() (
    exec 7>"$RUN/reconcile.lock"; flock -n 7 || return 0
    [ ! -f "$RUN/stopping" ] || return 0
    if [ "$(get mwan3.globals.aw1000_enabled)" != 1 ]; then
        if [ ! -f "$RUN/disabled" ]; then
            /etc/init.d/mwan3 stop
            /usr/sbin/aw1000-mwan-follow --restore
            touch "$RUN/disabled"
        fi
        return 0
    fi
    if [ -f "$RUN/disabled" ]; then
        rm -f "$RUN/disabled"
        touch "$RUN/reload-needed"
    fi
    tick || logger -t aw1000-internet '配置回退或 SIM 状态协调失败，将重试'
    reload_pending || logger -t aw1000-internet '网络重载失败，将重试'
    /usr/sbin/aw1000-uplink || logger -t aw1000-internet '蜂窝接口接入暂缓'
    route_guard || logger -t aw1000-internet 'WAN 默认路由自愈失败，将重试'
    /usr/sbin/aw1000-mwan-follow --once || touch "$RUN/dirty"
)
run() {
    while :; do
        reconcile_once
        sleep 2 & wait $! || true
    done
}
reload_pending() (
    exec 8>"$RUN/apply.lock"; flock -n 8 || return 0
    [ ! -f "$RUN/stopping" ] || return 0
    [ -f "$RUN/reload-needed" ] || [ -f "$RUN/mwan-reload-needed" ] || return 0
    if [ -f "$RUN/reload-needed" ]; then
        ubus call network reload '{}' >/dev/null || return 1
        /etc/init.d/firewall reload || return 1
        # Network and firewall work succeeded. A later mwan failure must not
        # repeatedly disrupt a working DHCP session by reloading them again.
        rm -f "$RUN/reload-needed"
    fi
    # Consume requests before rebuilding. Our firewall callback is now only a
    # marker writer, so it cannot deadlock on apply.lock. A newer external
    # firewall event arriving during rebuild leaves a fresh marker for retry.
    rm -f "$RUN/mwan-reload-needed"
    if /etc/init.d/mwan3 running; then action=restart; else action=start; fi
    if /etc/init.d/mwan3 "$action" && /etc/init.d/mwan3 running; then
        return 0
    fi
    touch "$RUN/mwan-reload-needed"
    return 1
)
case "${1:-}" in
    --run) run;;
    --classify) classify "$(cat)";;
    --sim-result) valid "${2:-}" && publish "$(cat)" "$2";;
    --monitor) monitor;;
    --ipv6-worker) exec /usr/sbin/aw1000-mwan-follow --ipv6-worker;;
    --tick) tick;;
    --resident-tick) tick 75;;
    --route-guard) route_guard;;
    --reload-pending)
        (exec 7>"$RUN/reconcile.lock"; flock -n 7 || exit 0; reload_pending);;
    --reconcile-once) reconcile_once;;
    --sim-state) sim_state "${2:-}";;
    --radio-result) publish_radio "$(cat)" "${2:-}";;
    --radio-state) radio_state "${2:-}";;
    --status) status;;
    --rpc)
        case "${2:-}" in
            list) echo '{"status":{},"apply":{"priority":"","mode":"","username":"","password":"","vlan":"","mtu":""},"apply_priority":{"priority":""},"scan":{"device":""},"confirm":{}}';;
            call)
                case "${3:-}" in
                    status) status;;
                    apply) apply;;
                    apply_priority) apply --priority-only;;
                    scan)
                        scan_device=$(jq -er '.device | select(.=="wifi0" or .=="wifi1")') || { echo '{"error":"无线设备无效"}'; exit 0; }
                        exec /usr/sbin/aw1000-wifi-toggle --scan "$scan_device";;
                    confirm)
                        exec 8>"$RUN/apply.lock"; flock -x 8
                        if [ ! -f "$PENDING/deadline" ]; then echo '{"error":"没有待确认设置"}'
                        elif [ "$(cat "$PENDING/boot")" != "$(cat /proc/sys/kernel/random/boot_id)" ] || [ "$(now)" -ge "$(cat "$PENDING/deadline")" ]; then
                            rollback; echo '{"error":"确认超时，已恢复原设置"}'
                        else rm -rf "$PENDING"; echo '{"ok":true}'; fi;;
                esac;;
        esac;;
    *) exit 2;;
esac
